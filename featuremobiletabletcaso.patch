diff --git a/css/case-study.css b/css/case-study.css
index e69de29..4637cbf 100644
--- a/css/case-study.css
+++ b/css/case-study.css
@@ -0,0 +1,264 @@
+/* ============================================
+   CASE STUDY — Base + Mobile/Tablet
+   Desktop (scrollytelling) vive en case-study-responsive.css,
+   gateado a MQ_DESKTOP:
+     (min-width: 1200px) and (hover: hover) and (pointer: fine)
+   Todo el layout mobile va dentro de MQ_MOBILE (el complemento
+   exacto) para no pisar ninguna regla del desktop:
+     (max-width: 1199.98px), (hover: none), (pointer: coarse)
+   Diseño según case-study-mobile.jpg.
+   ============================================ */
+
+/* ============================================
+   REVEALS MOBILE (.mrv) — usados por
+   js/modules/animations/mobile-reveals.js, que solo marca
+   elementos fuera de MQ_DESKTOP. Sin JS o con reduced-motion
+   nada recibe la clase → todo queda visible (estado seguro).
+   ============================================ */
+
+@media (prefers-reduced-motion: no-preference) {
+    .mrv {
+        opacity: 0;
+        transform: translateY(24px);
+        transition: opacity 0.6s ease-out, transform 0.6s ease-out;
+    }
+
+    .mrv--in {
+        opacity: 1;
+        transform: none;
+    }
+}
+
+@media (max-width: 1199.98px), (hover: none), (pointer: coarse) {
+
+    /* Padding lateral compartido por todas las secciones mobile */
+    :root {
+        --cs-mobile-pad: clamp(1.25rem, 5vw, 3rem);
+    }
+
+    /* Los SVGs decorativos y las imágenes grandes no deben generar
+       scroll horizontal en ningún caso. */
+    main#main {
+        overflow-x: clip;
+    }
+
+    /* ============================================
+       SECCIÓN 1 — APERTURA (hero con foto estática)
+       ============================================ */
+
+    .cs-apertura {
+        position: relative;
+        min-height: 100vh;
+        min-height: 100svh;
+        overflow: hidden;
+        display: flex;
+        align-items: flex-end;
+        background-color: var(--color-primary);
+        background-image: url(../assets/images/cases/product-design-ecommerce-asdeporte-mobile.webp);
+        background-size: cover;
+        background-position: center;
+        background-repeat: no-repeat;
+    }
+
+    /* El .mp4 no se descarga en mobile (data-src sin src en el HTML);
+       este display:none es el cinturón por si algún día vuelve el src. */
+    .cs-apertura__video {
+        display: none;
+    }
+
+    /* Overlay + viñeta — mismo tratamiento de contraste que desktop */
+    .cs-apertura__overlay {
+        position: absolute;
+        inset: 0;
+        background: var(--color-primary);
+        opacity: 0.35;
+        pointer-events: none;
+    }
+
+    .cs-apertura__vignette {
+        position: absolute;
+        inset: 0;
+        background: radial-gradient(
+            ellipse at center,
+            rgba(13, 13, 13, 0.2) 0%,
+            rgba(13, 13, 13, 0.7) 100%
+        );
+        pointer-events: none;
+    }
+
+    /* La sombra de transición es un mecanismo del scrubbing desktop */
+    .cs-apertura__shadow {
+        display: none;
+    }
+
+    /* Ticker → headline estático anclado abajo. El primer track se
+       comporta como H1 ("Una app de clase mundial que frenaba a sus
+       propios atletas."); el clon del loop y el separador se ocultan. */
+    .cs-apertura__ticker {
+        position: relative;
+        z-index: 4;
+        width: 100%;
+        padding: 0 var(--cs-mobile-pad) clamp(4rem, 12vh, 7rem);
+    }
+
+    .cs-ticker__track {
+        display: block;
+        white-space: normal;
