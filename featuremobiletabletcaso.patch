+        display: none;
+    }
+
+    .cs-ticker__word {
+        display: inline;
+    }
+
+    .cs-ticker__word.cs-headline {
+        font-size: clamp(2.5rem, 10vw, 4.5rem);
+    }
+
+    /* ============================================
+       STAGE HORIZONTAL → flujo vertical
+       Sin el CSS desktop, stage/track/inner son divs normales y las
+       secciones fluyen en orden DOM (= orden del diseño mobile).
+       El cometa es exclusivo del recorrido horizontal desktop.
+       ============================================ */
+
+    .cs-metrica__comet {
+        display: none;
+    }
+
+    /* ============================================
+       SECCIÓN 2 — MÉTRICA (KPI 25% ↗ + caption)
+       ============================================ */
+
+    .cs-metrica {
+        padding: clamp(5rem, 14vh, 8rem) var(--cs-mobile-pad);
+        background-color: var(--color-primary);
+    }
+
+    .cs-metrica__left {
+        display: flex;
+        flex-direction: column;
+        gap: 1.25rem;
+    }
+
+    .cs-metrica__kpi {
+        display: flex;
+        flex-direction: row;
+        align-items: flex-start;
+        gap: 0.15em;
+    }
+
+    /* La flecha llega ya trazada: los stroke-dasharray del estado
+       inicial viven en el CSS desktop (gateado). */
+    .cs-metrica__arrow {
+        width: clamp(44px, 11vw, 72px);
+        height: auto;
+        margin-top: clamp(16px, 5vw, 40px);
+        overflow: visible;
+    }
+
+    /* ============================================
+       SECCIÓN 3 — CONTEXTO (columna única)
+       ============================================ */
+
+    .cs-contexto {
+        display: flex;
+        flex-direction: column;
+        gap: 2rem;
+        padding: clamp(4rem, 10vh, 6rem) var(--cs-mobile-pad);
+        background-color: var(--color-primary);
+    }
+
+    .cs-contexto__col {
+        display: flex;
+        flex-direction: column;
+        gap: 1.5rem;
+    }
+
+    /* Flecha curva decorativa — pensada para el gap entre columnas
+       del layout desktop. */
+    .cs-contexto__arrow {
+        display: none;
+    }
+
+    .cs-contexto__media {
+        overflow: hidden;
+        border-radius: 16px;
+        width: 100%;
+        aspect-ratio: 3 / 2;
+    }
+
+    .cs-contexto__image {
+        display: block;
+        width: 100%;
+        height: 100%;
+        object-fit: cover;
+    }
+
+    .cs-contexto__tags {
+        display: flex;
+        flex-wrap: wrap;
+        gap: 0.75rem;
+    }
+
+    .cs-contexto__tag {
+        background-color: var(--color-bg);
+        padding: 4px 12px;
+        color: var(--color-accent);
+        border-radius: 1rem;
+    }
+
+    /* Párrafos completos, sin máscara ni track desplazable */
+    .cs-contexto__mask {
+        overflow: visible;
+        height: auto;
+    }
+
+    .cs-contexto__text-track {
+        display: flex;
+        flex-direction: column;
+        gap: 1.25rem;
+    }
+
+    .cs-contexto__mask p {
+        color: var(--color-text-secondary);
+    }
+
+    /* Botones MI ROL / EL PROCESO apilados a lo ancho */
+    .cs-contexto__actions {
+        display: flex;
+        flex-direction: column;
+        align-items: stretch;
+        gap: 1rem;
+        margin-top: 0.5rem;
+    }
+
+    .cs-contexto__actions .btn {
+        justify-content: space-between;
+    }
+
+    /* ============================================
+       TABLET (>= 700px) — refinos dentro de la versión mobile
+       (breakpoint canónico del sitio, ver responsive.css)
+       ============================================ */
+
+    @media (min-width: 700px) {
+        .cs-apertura {
+            background-image: url(../assets/images/cases/product-design-ecommerce-asdeporte-tablet.webp);
+        }
+
+        .cs-contexto__actions {
+            flex-direction: row;
+            align-items: center;
+        }
+
+        .cs-contexto__actions .btn {
+            justify-content: center;
+        }
+    }
+
+} /* fin MQ_MOBILE */
